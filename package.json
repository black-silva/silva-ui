{
 "name": "silva-ui",
 "version": "1.2.0",
 "description": "A Hono JSX UI component library with framework-neutral styling and Tamagui-inspired theming.",
 "main": "./dist/library/silva-ui.js",
 "module": "./dist/library/silva-ui.js",
 "types": "./dist/types/index.d.ts",
 "style": "./dist/library/silva-ui.css",
 "exports": {
  ".": {
   "types": "./dist/types/index.d.ts",
   "import": "./dist/library/silva-ui.js",
   "default": "./dist/library/silva-ui.js"
  },
  "./style.css": {
   "types": "./style.css.d.ts",
   "default": "./dist/library/silva-ui.css"
  }
 },
 "sideEffects": [
  "**/*.css"
 ],
 "files": [
  "dist/library",
  "dist/types",
  "style.css.d.ts",
  "README.md",
  "LICENSE"
 ],
 "scripts": {
  "dev": "vite",
  "build": "vite build",
  "build:library": "vite build --config vite.library.config.ts",
  "build:types": "tsc -p tsconfig.types.json",
  "build:package": "npm run build:library && npm run build:types",
  "profile:library": "vite build --config vite.library.config.ts --profile",
  "pack:check": "npm run build:package && npm pack --dry-run",
  "preview": "vite preview",
  "typecheck": "tsc --noEmit",
  "storybook": "storybook dev -p 6006",
  "build-storybook": "storybook build"
 },
 "keywords": [
  "ui",
  "ui-components",
  "component-library",
  "design-system",
  "hono",
  "hono-jsx",
  "jsx",
  "typescript",
  "vanilla-extract",
  "sprinkles",
  "theming",
  "accessible"
 ],
 "author": "BlackSilva",
 "license": "MIT",
 "type": "module",
 "peerDependencies": {
  "hono": "^4.13.13"
 },
 "devDependencies": {
  "@storybook/addon-a11y": "^10.6.6",
  "@storybook/addon-docs": "^10.6.6",
  "@storybook/html-vite": "^10.6.6",
  "@vanilla-extract/css": "^1.21.3",
  "@vanilla-extract/sprinkles": "^1.7.1",
  "@vanilla-extract/vite-plugin": "^5.2.6",
  "hono": "^4.13.13",
  "storybook": "^10.6.6",
  "typescript": "^7.0.2",
  "vite": "^8.3.4"
 },
 "repository": {
  "type": "git",
  "url": "git+https://github.com/black-silva/silva-ui.git"
 }
}
